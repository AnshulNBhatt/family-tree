
# --- vanshavali (family tree) --- added by ~/vanshavali/deploy/install.sh
__DOMAIN__ {
	import common
	reverse_proxy vanshavali:3000 {
		header_up X-Forwarded-For {client_ip}
		# live updates use server-sent events: pass each event through immediately
		flush_interval -1
	}
}
# --- end vanshavali ---
